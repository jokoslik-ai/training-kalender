<workout_file>
  <author>health-coach</author>
  <name>Rad-Intervalle · 60′ Rollentrainer: 15′ ein · 5×4′ @105 % FTP (220 W), 3′ @55 % · 10′ aus; Puls am Ende der Wdh. Z4 (≥156). Abbruchregel: Puls in Wdh. 1 &gt;170 oder schwere Beine → nach 4 Wdh. beenden</name>
  <description>15′ ein, 5×(4′ @105 %, 3′ @55 %), 10′ aus</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="900" PowerLow="0.45" PowerHigh="0.75"/>
    <IntervalsT Repeat="5" OnDuration="240" OnPower="1.05" OffDuration="180" OffPower="0.55"/>
    <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.40"/>
  </workout>
</workout_file>
