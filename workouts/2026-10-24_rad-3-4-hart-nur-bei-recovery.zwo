<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>health-coach</author>
  <name>Rad 3×4′ hart nur bei Recovery ≥🟡, sonst Z2 60′</name>
  <description>15′ ein, 3×(4′ @100 %, 3′ @55 %), 10′ aus</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Warmup Duration="900" PowerLow="0.45" PowerHigh="0.75"/>
    <IntervalsT Repeat="3" OnDuration="240" OnPower="1.00" OffDuration="180" OffPower="0.55"/>
    <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.40"/>
  </workout>
</workout_file>
